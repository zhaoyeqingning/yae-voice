XFYUN_APPID=
XFYUN_API_SECRET=
XFYUN_API_KEY=
XFYUN_TTS_VCN=x4_xiaoyan

LLM_BASE_URL=https://api.openlux.ai/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_ENABLE_THINKING=false

TTS_PROVIDER=openlux

# 下面四项只在 TTS_PROVIDER=openlux 时使用
TTS_MODEL=tts-1
TTS_VOICE=shimmer
TTS_SPEED=1.15
TTS_INSTRUCTIONS=Voice Affect: Calm and reassuring. Tone: Sincere, warm, and gentle. Pacing: Steady, natural conversation. Emotion: Quiet care. Pronunciation: Standard Mandarin, clear and unforced.

# 切到阿里百炼 CosyVoice：把 TTS_PROVIDER 改成 cosyvoice，并填 DASHSCOPE_API_KEY。
# TTS_INSTRUCTIONS 在 cosyvoice-v2 上没有对应字段，会被忽略；
# TTS_SPEED 会折算成 rate（clamp 到 0.5~2.0），COSYVOICE_RATE 优先。
# TTS_PROVIDER=cosyvoice
# DASHSCOPE_API_KEY=
# COSYVOICE_MODEL=cosyvoice-v2
# COSYVOICE_VOICE=longxiaochun_v2
# COSYVOICE_SAMPLE_RATE=24000
# COSYVOICE_RATE=1.0
# COSYVOICE_VOLUME=50

# 切到豆包 2.0（火山引擎双向流式）：TTS_PROVIDER 改成 doubao。
# 音色必须是 2.0 音色（以 _uranus_bigtts 结尾），否则会话会失败；
# TTS_SPEED 折算成 speech_rate：0.5→-50、1.0→0、2.0→100。
# TTS_PROVIDER=doubao
# DOUBAO_API_KEY=
# DOUBAO_SPEAKER=zh_female_gaolengyujie_uranus_bigtts
# DOUBAO_RESOURCE_ID=seed-tts-2.0
# DOUBAO_SAMPLE_RATE=24000
# DOUBAO_CONTEXT=你可以用特别温柔的语气说话吗?

# 网页文字入口：python web_server.py  → http://127.0.0.1:8787
# YAE_WEB_FAKE=1
# YAE_WEB_HOST=127.0.0.1
# YAE_WEB_PORT=8787
# SYSTEM_PROMPT=你是 Evanescia，语气轻松自然，用简体中文短句回复，像面对面聊天。
