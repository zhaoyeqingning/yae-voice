# ===== 讯飞 ASR（语音转文字）=====
# 如果 LLM_USE_AUDIO=true（多模态模式），可以不填
XFYUN_APPID=
XFYUN_API_SECRET=
XFYUN_API_KEY=
XFYUN_TTS_VCN=x4_xiaoyan

# ===== LLM =====
LLM_BASE_URL=https://api.openlux.ai/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_ENABLE_THINKING=false
# 设为 true 时使用多模态音频模型（如 gpt-4o-audio-preview），
# 直接吃麦克风音频，跳过讯飞 ASR，降低延迟
LLM_USE_AUDIO=false

# ===== TTS（文字转语音）=====
# 选择 TTS 提供商：openlux / minimax / elevenlabs
TTS_PROVIDER=openlux
TTS_SPEED=1.15

# --- OpenLux / OpenAI 兼容 TTS（默认）---
TTS_MODEL=tts-1
TTS_VOICE=shimmer
TTS_INSTRUCTIONS=Voice Affect: Calm and reassuring. Tone: Sincere, warm, and gentle. Pacing: Steady, natural conversation. Emotion: Quiet care. Pronunciation: Standard Mandarin, clear and unforced.

# --- MiniMax TTS（高质量中文语音）---
# TTS_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ID=female-tianmei

# --- ElevenLabs TTS（多语种 / 音色克隆）---
# TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=rachel

# ===== 网页入口 =====
# python web_server.py  → http://127.0.0.1:8787
# YAE_WEB_FAKE=1
# YAE_WEB_HOST=127.0.0.1
# YAE_WEB_PORT=8787
# SYSTEM_PROMPT=你是 Evanescia，语气轻松自然，用简体中文短句回复，像面对面聊天。
